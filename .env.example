# Copy to .env for local Docker Compose, then replace the placeholders.
POSTGRES_DB=northstar
POSTGRES_USER=northstar
POSTGRES_PASSWORD=local-only-change-this-before-use
SECRET_KEY=local-only-use-a-long-random-secret-before-deploying
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
WEB_PORT=8080
API_PORT=8000
SEED_DEMO_DATA=false
ADMIN_SIGNUP_CODE=replace-with-a-long-one-time-admin-invite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback
PUBLIC_API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false
